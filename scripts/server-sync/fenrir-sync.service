[Unit]
Description=Update Fenrir-Backup server from GitHub
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=FENRIR_REPO_DIR=/opt/fenrir-backup
ExecStart=/opt/fenrir-backup/scripts/server-sync/fenrir-sync.sh
# Rust builds are slow on small servers.
TimeoutStartSec=2h
Nice=10
